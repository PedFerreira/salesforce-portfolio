# Copie para .env.local para rodar localmente (npm run dev).
# Todos os valores são PÚBLICOS (vão no JavaScript do navegador) — a
# segurança vem das funções/policies do banco, não de esconder estas chaves.

# Supabase: Project Settings -> API (URL e chave anon/publishable)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Cloudflare Turnstile: Site Key do widget. Em branco = sem captcha (só dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Caminho em que o app é servido. Padrão: /poker (pedroferreira.site/poker).
# Para rodar na raiz localmente: NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_BASE_PATH=/poker
